# Copy to .env. Everything is optional: with nothing set the app runs in demo mode.

# --- Reading pages -----------------------------------------------------------
# auto: local OCR + templates if ocr/.venv exists, else Claude if credentials are set, else mock.
EXTRACTOR=auto
# Who resolves cells the local reader is unsure of: none (ask the midwife) | claude-code | claude
AI_FALLBACK=none
REVIEW_THRESHOLD=0.8

# Claude API (only for AI_FALLBACK=claude or EXTRACTOR=claude)
ANTHROPIC_API_KEY=
# Only needed if the key is not scoped to a workspace (Console → Settings → Workspaces → ID).
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=medium

# --- Public address (for WhatsApp webhooks) ----------------------------------
# `npm run tunnel` uses a permanent ngrok address when both are set (free account:
# dashboard.ngrok.com → Your Authtoken, and Domains → your free static domain).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Otherwise a temporary cloudflared address is used. PUBLIC_URL overrides both.
PUBLIC_URL=

# --- WhatsApp via Vonage sandbox (demo) ---------------------------------------
VONAGE_API_KEY=
VONAGE_API_SECRET=

# --- WhatsApp via Meta Cloud API (production; needs business verification) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=

# --- WhatsApp via Twilio (needs a paid account) --------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Telegram (free alternative) --------------------------------------------
TELEGRAM_BOT_TOKEN=
